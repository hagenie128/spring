<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.spring.mapper.BoardMapper">

  <!-- TODO 3: board_view를 최신순으로 페이징 조회하세요. -->
  <select id="selectBoardList" resultType="board">
    select * from board_view where 1 = 0
  </select>

  <!-- TODO 3: 제목 또는 내용 검색과 페이징을 구현하세요. ${} 대신 #{}를 사용하세요. -->
  <select id="searchBoardList" resultType="board">
    select * from board_view where 1 = 0
  </select>

  <select id="boardCount" resultType="int">
    select count(*) from board_view
  </select>

  <!-- TODO 3: bno로 게시글 하나를 조회하세요. -->
  <select id="selectBoard" resultType="board">
    select * from board_view where 1 = 0
  </select>

  <!-- TODO 3: board_comment_view에서 게시글 댓글을 조회하세요. -->
  <select id="selectBoardComment" resultType="comment">
    select * from board_comment_view where 1 = 0
  </select>
</mapper>
